# Copy this file to .env.local (already gitignored) and fill in real local values.
#
# Values below come from the *local* Supabase CLI stack only:
#   supabase start   (prints them on first run)
#   supabase status  (prints them again any time after)
#
# This CLI version emits the newer Supabase API key pair -- PUBLISHABLE_KEY and
# SECRET_KEY -- alongside the legacy ANON_KEY/SERVICE_ROLE_KEY JWTs. Only the
# PUBLISHABLE_KEY is browser-safe; use that one here, mapped to Vite's
# required VITE_ prefix. Never put SECRET_KEY (or the legacy
# SERVICE_ROLE_KEY) in a VITE_-prefixed variable -- it must never reach the
# browser bundle.

# supabase status -> API_URL
VITE_SUPABASE_URL=http://127.0.0.1:54321

# supabase status -> PUBLISHABLE_KEY (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
